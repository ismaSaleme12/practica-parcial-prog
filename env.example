# Copiar a .env y completar. .env NO se versiona.
# Sin POSTGRES_PASSWORD ni SECRET_KEY la aplicación no arranca (sin valores por defecto).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taller_mecanico
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Clave de firma del JWT: obligatoria, sin default. Usar al menos 32 bytes
# (RFC 7518): PyJWT advierte y el HS256 queda debilitado con claves cortas.
SECRET_KEY=change_me_in_production_secret_key

# Costo de bcrypt y cuántos hashes corren a la vez fuera del bucle de eventos.
BCRYPT_ROUNDS=12
BCRYPT_MAX_CONCURRENT_HASHES=4

TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
SQL_ECHO=false
POOL_SIZE=5
